# AlcatechFinancas — Template de variaveis de ambiente
# Copie para .env e preencha com os valores do seu ambiente

APP_ENV=development
APP_URL=http://localhost

DB_HOST=localhost
DB_PORT=3306
DB_NAME=alcatech_financas
DB_USER=root
DB_PASS=

# E-mails (login do app, separados por vírgula) autorizados a acessar /admin/sql
SQL_CONSOLE_ADMINS=
