# Quando a webroot do plano apontar para a raiz do projeto (Hostinger sem subdiretório)
# este arquivo redireciona qualquer request para /public.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
 
<FilesMatch "^\.(env|gitignore)$">
    Require all denied
</FilesMatch>
Options -Indexes