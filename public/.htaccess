# =========================================================
# Nivix - .htaccess (Apache / Hostinger)
# =========================================================
 
# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
 
# Cache estático
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg          "access plus 30 days"
    ExpiresByType image/jpeg         "access plus 30 days"
    ExpiresByType image/png          "access plus 30 days"
    ExpiresByType image/webp         "access plus 30 days"
    ExpiresByType image/svg+xml      "access plus 30 days"
    ExpiresByType text/css           "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2         "access plus 30 days"
</IfModule>
 
# Headers de segurança
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
 
# Front controller
<IfModule mod_rewrite.c>
    RewriteEngine On
 
    # Forçar HTTPS (descomente em produção)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
 
    # Forçar sem www (opcional)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
 
    # Não rotear arquivos/diretórios reais
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
 
    # Tudo vai para index.php
    RewriteRule ^ index.php [L]
</IfModule>
 
# Bloquear acesso direto a arquivos sensíveis
<FilesMatch "^\.(env|gitignore|htaccess)$">
    Require all denied
</FilesMatch>
 
DirectoryIndex index.php
Options -Indexes